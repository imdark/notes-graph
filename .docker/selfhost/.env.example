# select a revision to deploy, available values: stable, beta, canary
NOTESGRAPH_REVISION=stable

# set the port for the server container it will expose the server on
PORT=3010

# set the host for the server for outgoing links
# NOTESGRAPH_SERVER_HTTPS=true
# NOTESGRAPH_SERVER_HOST=notesgraph.yourdomain.com
# or 
# NOTESGRAPH_SERVER_EXTERNAL_URL=https://notesgraph.yourdomain.com

# position of the database data to persist
DB_DATA_LOCATION=~/.notesgraph/self-host/postgres/pgdata
# position of the upload data(images, files, etc.) to persist
UPLOAD_LOCATION=~/.notesgraph/self-host/storage
# position of the configuration files to persist
CONFIG_LOCATION=~/.notesgraph/self-host/config

# database credentials
DB_USERNAME=notesgraph
DB_PASSWORD=
DB_DATABASE=notesgraph

# --- Uppy Companion (optional): lets the file uploader pull files in from
# --- Google Drive / Dropbox. Leave every COMPANION_* var below unset to skip
# --- this entirely — the app falls back to local-file uploads with no
# --- behavior change. To enable it:
# ---   1. Set NOTESGRAPH_COMPANION_URL to wherever the uppy_companion
# ---      service (see compose.yml) is reachable from the browser, e.g.
# ---      https://companion.yourdomain.com or https://notesgraph.yourdomain.com/companion
# ---   2. Register an OAuth app in Google Cloud Console (APIs & Services >
# ---      Credentials > OAuth client ID > Web application) with redirect URI
# ---      <NOTESGRAPH_COMPANION_URL>/drive/redirect, and set
# ---      COMPANION_GOOGLE_KEY / COMPANION_GOOGLE_SECRET to its client ID/secret.
# ---   3. Register an app in the Dropbox App Console with redirect URI
# ---      <NOTESGRAPH_COMPANION_URL>/dropbox/redirect, and set
# ---      COMPANION_DROPBOX_KEY / COMPANION_DROPBOX_SECRET to its app key/secret.
# NOTESGRAPH_COMPANION_URL=https://companion.yourdomain.com
# COMPANION_DOMAIN=companion.yourdomain.com
# COMPANION_PROTOCOL=https
# COMPANION_SECRET=
# COMPANION_GOOGLE_KEY=
# COMPANION_GOOGLE_SECRET=
# COMPANION_DROPBOX_KEY=
# COMPANION_DROPBOX_SECRET=
# comma-separated list of origins allowed to call Companion (your app's URL)
# COMPANION_CLIENT_ORIGINS=https://notesgraph.yourdomain.com
