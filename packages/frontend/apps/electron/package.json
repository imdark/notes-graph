{
  "name": "@notesgraph/electron",
  "private": true,
  "version": "0.26.3",
  "main": "./dist/main.js",
  "author": "toeverything",
  "repository": {
    "url": "https://github.com/notesgraph/notesgraph",
    "type": "git"
  },
  "description": "NotesGraph Desktop App",
  "homepage": "https://github.com/notesgraph/notesgraph",
  "exports": {
    "./helper/exposed": "./src/helper/exposed.ts",
    "./main/exposed": "./src/main/exposed.ts",
    "./preload/electron-api": "./src/preload/electron-api.ts",
    "./preload/shared-storage": "./src/preload/shared-storage.ts",
    "./main/shared-state-schema": "./src/main/shared-state-schema.ts",
    "./main/updater/event": "./src/main/updater/event.ts",
    "./main/windows-manager": "./src/main/windows-manager/index.ts"
  },
  "scripts": {
    "start": "electron .",
    "dev": "cross-env DEV_SERVER_URL=http://localhost:8080 node --import tsx/esm ./scripts/dev.ts",
    "dev:prod": "node --import tsx/esm ./scripts/dev.ts",
    "build": "cross-env NODE_ENV=production node --import tsx/esm ./scripts/build-layers.ts",
    "build:dev": "node --import tsx/esm ./scripts/build-layers.ts",
    "generate-assets": "node --import tsx/esm ./scripts/generate-assets.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make-squirrel": "node --import tsx/esm ./scripts/make-squirrel.ts",
    "make-nsis": "node --import tsx/esm ./scripts/make-nsis.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/core": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-flatpak": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@notesgraph-tools/utils": "workspace:*",
    "@notesgraph/i18n": "workspace:*",
    "@notesgraph/infra": "workspace:*",
    "@notesgraph/link-card": "workspace:*",
    "@notesgraph/native": "workspace:*",
    "@notesgraph/nbstore": "workspace:*",
    "@reforged/maker-appimage": "^5.2.0",
    "@sentry/electron": "^7.13.0",
    "@sentry/esbuild-plugin": "^5.3.0",
    "@types/set-cookie-parser": "^2.4.10",
    "app-builder-lib": "^26.8.1",
    "builder-util-runtime": "^9.5.1",
    "cross-env": "^10.1.0",
    "debug": "^4.4.0",
    "electron": "^39.0.0",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "1.0.1",
    "electron-window-state": "^5.0.3",
    "esbuild": "^0.28.0",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "lodash-es": "^4.17.23",
    "msw": "^2.13.2",
    "nanoid": "^5.1.6",
    "rxjs": "^7.8.2",
    "semver": "^7.7.3",
    "tree-kill": "^1.2.2",
    "typescript": "^5.9.3",
    "uuid": "^14.0.0",
    "vitest": "^4.1.8",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "async-call-rpc": "^6.4.2",
    "electron-updater": "^6.8.3",
    "link-preview-js": "^4.0.0",
    "set-cookie-parser": "^2.7.1",
    "sharp": "^0.35.2",
    "yjs": "^13.6.27"
  },
  "build": {
    "protocols": [
      {
        "name": "notesgraph",
        "schemes": [
          "notesgraph"
        ]
      }
    ]
  }
}
